# Client-side (Vite exposes anything prefixed VITE_ to the browser bundle —
# only put the Supabase URL and ANON key here, never a service-role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (set this in Vercel project settings, NOT in this file
# if you commit it — keep .env out of git, see .gitignore)
GROQ_API_KEY=your-groq-key
